# Copy this to .env and add your API keys.

# Existing market-data integrations
ALPHA_VANTAGE_API_KEY=your_key_here
POLYGON_API_KEY=your_key_here
IEX_CLOUD_API_KEY=your_key_here

# Financial filings RAG integrations
SEC_USER_AGENT=your_name your_email@example.com
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.2
VOYAGE_API_KEY=your_voyage_key_here
FMP_API_KEY=optional_fmp_key_here

# Local RAG services for the future Docker Compose stack
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/financial_rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
