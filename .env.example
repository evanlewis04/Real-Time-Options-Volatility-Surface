# Copy this to .env and add your keys. All keys are optional: the default
# workflows run cache-only/offline. Keys only unlock live data and dense
# retrieval.

# SEC EDGAR ingestion (free; needed only for --fetch-sec). SEC's fair-access
# policy requires a real contact string: "Your Name your_email@example.com".
SEC_USER_AGENT=your_name your_email@example.com

# Voyage embeddings for dense retrieval (optional; lexical retrieval works
# without them).
VOYAGE_API_KEY=your_voyage_key_here

# OpenAI for the opt-in, citation-validated answer synthesis (optional).
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.2
